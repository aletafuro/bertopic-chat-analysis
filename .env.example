# Database MySQL — copia in .env e compila con le tue credenziali
DB_USER=your_username
DB_PASS=your_password
DB_HOST=your_host
DB_PORT=3306
DB_NAME=your_database

# Gemini AI (opzionale — solo celle 6 e 7)
# Ottieni la tua API key gratuita su https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Hugging Face (opzionale — evita rate limit download modelli)
HF_TOKEN=your_hf_token
